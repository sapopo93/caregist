FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt requirements-worker.txt requirements-worker-model.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt -r requirements-worker-model.txt

COPY api/ api/
COPY workers/ workers/

CMD ["python", "-m", "workers.crm_ai_worker"]
