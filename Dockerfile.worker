FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

WORKDIR /app

ENV PATH="/opt/venv/bin:$PATH"

# apt and libapt-pkg6.0t64 are named so the base image's copies are upgraded
# (Trivy HIGH CVE-2026-109518, fixed in 2.8.4ubuntu0.1, 11 Nov 2026).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg python3 python3-venv \
       apt libapt-pkg6.0t64 \
    && python3 -m venv /opt/venv \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt requirements-worker.txt requirements-worker-model.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt \
    && pip install --no-cache-dir --no-deps --require-hashes -r requirements-worker-model.txt

COPY api/ api/
COPY workers/ workers/

CMD ["python3", "-m", "workers.crm_ai_worker"]
